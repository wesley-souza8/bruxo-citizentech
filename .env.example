# Chaves de API (nunca versione o arquivo .env real)
GROQ_API_KEY=sua_chave_groq_aqui
OPENWEATHER_API_KEY=sua_chave_openweathermap_aqui
AWESOME_API_KEY=sua_chave_awesomeapi_aqui

# Integração Arduino <-> Python (Serial)
# Deixe ARDUINO_PORTA vazio para detecção automática ou informe a porta (ex: COM3, /dev/ttyACM0)
ARDUINO_PORTA=
ARDUINO_BAUDRATE=9600
DISTANCIA_ATIVACAO_CM=50
COOLDOWN_TOTEM_SEGUNDOS=30
DURACAO_SESSAO_TOTEM_SEGUNDOS=45
